38769>>>    Procedure SetActionButtons
38772>>>        tWebNavigateData NavigateData
38772>>>        tWebNavigateData NavigateData
38772>>>        Boolean bHasRecord
38772>>>        Handle hoDD
38772>>>
38772>>>        Get Server to hoDD
38773>>>        Get GetNavigateData to NavigateData
38774>>>        Get HasRecord of hoDD to bHasRecord
38775>>>
38775>>>        // let's hide all buttons and then Show the ones we want
38775>>>        WebSet pbRender of oEditBtn to False
38776>>>        WebSet pbRender of oSaveBtn to False
38777>>>        WebSet pbRender of oCancelChangesBtn to False
38778>>>        WebSet pbRender of oDeleteBtn to False
38779>>>
38779>>>        If (NavigateData.bReadOnly) Begin
38781>>>            WebSet pbRender of oEditBtn to True
38782>>>        End
38782>>>>
38782>>>        Else Begin
38783>>>            WebSet pbRender of oSaveBtn to True
38784>>>            WebSet pbRender of oCancelChangesBtn to True
38785>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38786>>>        End
38786>>>>
38786>>>    End_Procedure
