38810>>>                // If from child, this is a probably a parent Zoom from a Zoom.
38810>>>                Case Break
38811>>>
38811>>>            Case Else // must be nfUndefined
38811>>>
38811>>>        Case End
38811>>>
38811>>>        Send SetActionButtons
